FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install latest security updates for Debian packages
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY app/main.py .

RUN useradd --system --uid 10001 appuser
USER 10001

EXPOSE 8080

CMD ["python", "main.py"]
